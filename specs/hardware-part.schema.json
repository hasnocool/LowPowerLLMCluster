{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lowpowerllmcluster/hardware-part.schema.json",
  "title": "LowPowerLLMCluster catalog fragment",
  "type": "object",
  "required": ["parts"],
  "properties": {
    "parts": {
      "type": "array",
      "items": {"$ref": "#/$defs/part"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "part": {
      "type": "object",
      "required": ["id", "category", "name", "vendor", "price_min_usd", "price_max_usd", "price_status", "moq", "url", "verified_on", "listing_status", "plain_language"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "category": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 3},
        "vendor": {"type": "string", "minLength": 1},
        "price_min_usd": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "price_max_usd": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "price_status": {"type": "string", "minLength": 3},
        "moq": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "format": "uri"},
        "source_url": {"type": "string", "format": "uri"},
        "verified_on": {"type": "string", "format": "date"},
        "listing_status": {"type": "string", "minLength": 1},
        "hardware_class": {"type": "string"},
        "accelerator_family": {"type": "string"},
        "accelerator": {"type": "string"},
        "host_mode": {"type": "string"},
        "host_requirements": {"type": "string"},
        "llm_support": {"type": "string"},
        "workload_role": {"type": "string"},
        "software_stack": {"type": "string"},
        "precision_formats": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "llm_candidate": {"type": "boolean"},
        "memory_capacity_gb": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "memory_bandwidth_gbps": {"type": "number", "exclusiveMinimum": 0},
        "peak_int4_tops": {"type": "number", "minimum": 0},
        "peak_int8_tops": {"type": "number", "minimum": 0},
        "peak_fp16_tflops": {"type": "number", "minimum": 0},
        "power_target_w": {"type": "number", "exclusiveMinimum": 0},
        "power_max_w": {"type": "number", "exclusiveMinimum": 0},
        "power_scope": {"type": "string"},
        "software_maturity": {"type": "string"},
        "risk_level": {"enum": ["low", "medium", "high"]},
        "lifecycle_status": {"type": "string"},
        "plain_language": {"type": "string", "minLength": 10},
        "source_notes": {"type": "string"},
        "max_memory_gb": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "cpu_max_memory_gb": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "max_memory_source_url": {"type": "string", "format": "uri"},
        "max_memory_verified_on": {"type": "string", "format": "date"},
        "memory_config_status": {"enum": ["included", "fixed", "configurable", "unknown"]},
        "source_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "seller_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sku_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "form_factor": {"type": "string"},
        "dimensions_mm": {
          "type": "object",
          "properties": {
            "width_mm": {"type": "number", "exclusiveMinimum": 0},
            "depth_mm": {"type": "number", "exclusiveMinimum": 0},
            "height_mm": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        },
        "dc_input_v": {"type": "number", "exclusiveMinimum": 0},
        "dc_input_min_v": {"type": "number", "exclusiveMinimum": 0},
        "dc_input_max_v": {"type": "number", "exclusiveMinimum": 0},
        "dc_connector": {"type": "string"},
        "psu_requirements": {"type": "string"},
        "cooling_requirements": {"type": "string"},
        "performance_evidence": {
          "type": "object",
          "properties": {
            "source_type": {"enum": ["measured_local", "community_measured", "vendor_measured", "derived_estimate", "spec_based_estimate", "unknown"]},
            "confidence": {"enum": ["high", "medium", "low", "unknown"]},
            "source_url": {"type": "string", "format": "uri"},
            "notes": {"type": "string"}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
