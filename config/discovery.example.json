{
  "concurrency": 4,
  "timeout_s": 20,
  "disappearance_after_runs": 2,
  "sources": [
    {
      "name": "manufacturer-pages",
      "type": "jsonld",
      "source_trust": 0.95,
      "urls": [
        "https://store.minisforum.com/en-os/products/minisforum-um890pro-mini-pc"
      ]
    },
    {
      "name": "example-json-feed",
      "type": "json",
      "endpoint": "https://example.invalid/catalog.json",
      "source_trust": 0.7,
      "items_path": "products",
      "fields": {
        "source_id": "id",
        "listing_url": "url",
        "title": "name",
        "price": "price",
        "currency": "currency",
        "seller": "seller.name",
        "seller_rating": "seller.rating",
        "seller_review_count": "seller.review_count",
        "seller_verified": "seller.verified",
        "manufacturer": "manufacturer",
        "sku": "sku",
        "mpn": "mpn",
        "in_stock": "in_stock"
      },
      "attribute_fields": {
        "cpu": "specs.cpu",
        "memory_capacity_gb": "specs.memory_gb",
        "board_max_memory_gb": "specs.max_memory_gb",
        "board_max_memory_source_url": "specs.max_memory_source_url",
        "dimensions": "specs.dimensions",
        "dc_input_v": "specs.dc_input_v",
        "power_adapter": "specs.power_adapter",
        "cooling": "specs.cooling",
        "host_requirements": "specs.host_requirements"
      }
    }
  ]
}
