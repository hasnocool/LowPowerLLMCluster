{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lowpowerllmcluster/hardware-catalog.schema.json",
  "title": "LowPowerLLMCluster catalog manifest",
  "type": "object",
  "required": ["schema_version", "snapshot_date", "currency", "candidate_categories", "part_files"],
  "properties": {
    "schema_version": {"const": 3},
    "snapshot_date": {"type": "string", "format": "date"},
    "currency": {"const": "USD"},
    "project_scope": {"type": "string"},
    "candidate_categories": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "part_files": {
      "type": "array",
      "items": {"type": "string", "pattern": "^catalog/.+\\.json$"},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
