{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lowpowerllmcluster/hardware-catalog.schema.json",
  "title": "LowPowerLLMCluster hardware catalog",
  "type": "object",
  "required": ["schema_version", "snapshot_date", "currency", "parts"],
  "properties": {
    "schema_version": {"const": 2},
    "snapshot_date": {"type": "string", "format": "date"},
    "currency": {"const": "USD"},
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "name", "vendor", "price_min_usd", "price_max_usd", "moq", "url", "verified_on", "listing_status", "plain_language"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "category": {"type": "string"},
          "price_min_usd": {"type": "number", "minimum": 0},
          "price_max_usd": {"type": "number", "minimum": 0},
          "moq": {"type": "integer", "minimum": 1},
          "url": {"type": "string", "format": "uri"},
          "verified_on": {"type": "string", "format": "date"},
          "llm_candidate": {"type": "boolean"},
          "memory_capacity_gb": {"type": "number", "exclusiveMinimum": 0},
          "risk_level": {"enum": ["low", "medium", "high"]}
        }
      }
    }
  }
}
