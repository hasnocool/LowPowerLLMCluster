{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name"],
  "$defs": {
    "metricEvidence": {
      "type": "object",
      "required": ["value", "source_type", "confidence"],
      "properties": {
        "value": {"type": "number"},
        "source_type": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "workloads": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "runtimes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "precisions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metricEvidence"}},
    "price_usd": {"$ref": "#/$defs/metricEvidence"},
    "usable_ai_memory_gb": {"$ref": "#/$defs/metricEvidence"},
    "memory_bandwidth_gbs": {"$ref": "#/$defs/metricEvidence"},
    "context_capacity_tokens": {"$ref": "#/$defs/metricEvidence"},
    "model_capacity_b_q4": {"$ref": "#/$defs/metricEvidence"},
    "decode_tokens_s": {"$ref": "#/$defs/metricEvidence"},
    "prefill_tokens_s": {"$ref": "#/$defs/metricEvidence"},
    "system_power_w": {"$ref": "#/$defs/metricEvidence"},
    "prefill_power_w": {"$ref": "#/$defs/metricEvidence"},
    "idle_w": {"$ref": "#/$defs/metricEvidence"},
    "fp16_tflops": {"$ref": "#/$defs/metricEvidence"},
    "int8_tops": {"$ref": "#/$defs/metricEvidence"},
    "dc_powerability": {"$ref": "#/$defs/metricEvidence"},
    "sleep_wake": {"$ref": "#/$defs/metricEvidence"},
    "benchmarked_context_tokens": {"type": "integer", "minimum": 0},
    "confidence": {"type": "object"},
    "software": {"type": "object"},
    "deployability": {"type": "object"},
    "soak": {"type": "object"}
  },
  "additionalProperties": true
}
