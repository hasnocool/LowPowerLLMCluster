      "ssd_controller": ["Controller"]
    },
    "NVIDIA": {
      "vbios_version": ["VBIOS", "Video BIOS"],
      "gpu_board_revision": ["Board Revision", "PCB Revision"]
    },
    "ASUS": {
      "vbios_version": ["VBIOS", "BIOS Version"],
