{
  "agent_workers": 4,
  "subworkers_per_agent": 4,
  "normalize_workers": 2,
  "queue_size": 64,
  "http_concurrency": 16,
  "http_per_host": 4,
  "timeout_s": 20,
  "max_response_bytes": 8388608,
  "retry_attempts": 3,
  "retry_backoff_base_s": 0.5,
  "retry_backoff_max_s": 15,
  "retry_jitter_s": 0.25,
  "adaptive_concurrency": true,
  "adaptive_min_subworkers": 1,
  "adaptive_success_window": 8,
  "adaptive_latency_target_ms": 1500,
  "stream_batch_size": 256,
  "cache_observation_limit": 5000,
  "disappearance_after_runs": 2,
  "sources": [
    {
      "name": "manufacturer-pages",
      "type": "jsonld",
      "source_trust": 0.95,
      "subworkers": 4,
      "urls": ["https://store.minisforum.com/en-os/products/minisforum-um890pro-mini-pc"]
    },
    {
      "name": "example-json-feed",
      "type": "json",
      "source_trust": 0.7,
      "endpoint": "https://example.invalid/catalog.json",
      "batch_size": 256,
      "items_path": "products",
      "fields": {"source_id":"id","listing_url":"url","title":"name","price":"price","currency":"currency","seller":"seller.name","seller_rating":"seller.rating","seller_review_count":"seller.review_count","seller_verified":"seller.verified","manufacturer":"manufacturer","sku":"sku","mpn":"mpn","in_stock":"in_stock"},
      "attribute_fields": {"cpu":"specs.cpu","memory_capacity_gb":"specs.memory_gb","board_max_memory_gb":"specs.max_memory_gb","board_max_memory_source_url":"specs.max_memory_source_url","dimensions":"specs.dimensions","dc_input_v":"specs.dc_input_v","power_adapter":"specs.power_adapter","cooling":"specs.cooling","host_requirements":"specs.host_requirements"}
    }
  ]
}
