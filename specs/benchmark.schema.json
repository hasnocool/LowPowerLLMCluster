{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lowpowerllmcluster/benchmark.schema.json",
  "title": "LowPowerLLMCluster measured benchmark result",
  "type": "object",
  "required": [
    "schema_version", "result_id", "created_at", "hardware_id", "configuration_id",
    "runtime", "model", "workload_class", "workload", "fit", "metrics", "power", "cost", "efficiency"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "result_id": {"type": "string"},
    "created_at": {"type": "string"},
    "hardware_id": {"type": "string"},
    "configuration_id": {"type": "string"},
    "hardware_snapshot": {"type": "object"},
    "system": {"type": "object"},
    "runtime": {"type": "object"},
    "model": {
      "type": "object",
      "required": ["name", "quantization"],
      "properties": {
        "name": {"type": "string"},
        "quantization": {"type": "string"},
        "sha256": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "workload_class": {"enum": ["llm", "vision", "audio", "embedding", "other"]},
    "workload": {"type": "object"},
    "fit": {"type": "object"},
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["unit", "samples", "median", "mean", "stdev", "minimum", "maximum"]
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["phase", "scope", "source", "duration_s", "samples_w", "mean_w", "median_w", "energy_j"]
      }
    },
    "cost": {"type": "object"},
    "efficiency": {"type": "object"},
    "raw": {"type": "object"}
  }
}
