    "manufacturer_https_only": true,
    "minimum_identity_score": 0.72,
    "cache_ttl_days": 30,
    "timeout_seconds": 20,
    "max_candidate_urls": 10,
    "max_sitemaps_per_domain": 8,
    "max_urls_scanned_per_domain": 12000
