{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lowpowerllmcluster/normalized-device.schema.json",
  "title": "LowPowerLLMCluster normalized optimizer device",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "workloads": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "runtimes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "precisions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "price_usd": {"type": "number", "minimum": 0},
    "usable_ai_memory_gb": {"type": "number", "minimum": 0},
    "memory_bandwidth_gbs": {"type": "number", "minimum": 0},
    "context_capacity_tokens": {"type": "integer", "minimum": 0},
    "model_capacity_b_q4": {"type": "number", "minimum": 0},
    "decode_tokens_s": {"type": "number", "minimum": 0},
    "prefill_tokens_s": {"type": "number", "minimum": 0},
    "time_to_first_token_ms": {"type": "number", "minimum": 0},
    "system_power_w": {"type": "number", "minimum": 0},
    "idle_w": {"type": "number", "minimum": 0},
    "cooling_overhead_w": {"type": "number", "minimum": 0},
    "fp32_tflops": {"type": "number", "minimum": 0},
    "fp16_tflops": {"type": "number", "minimum": 0},
    "bf16_tflops": {"type": "number", "minimum": 0},
    "fp8_tflops": {"type": "number", "minimum": 0},
    "int8_tops": {"type": "number", "minimum": 0},
    "int4_tops": {"type": "number", "minimum": 0},
    "dc_powerability": {"type": "number", "minimum": 0, "maximum": 100},
    "sleep_wake": {"type": "number", "minimum": 0, "maximum": 100},
    "software_support": {"type": "number", "minimum": 0, "maximum": 100},
    "reliability": {"type": "number", "minimum": 0, "maximum": 100},
    "metrics": {"type": "object"},
    "confidence": {"type": "object"},
    "software": {"type": "object"},
    "deployability": {"type": "object"},
    "soak": {"type": "object"}
  },
  "additionalProperties": true
}
