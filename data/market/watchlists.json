{
  "schema_version": 1,
  "watchlists": [
    {
      "id": "budget-llm-nodes",
      "description": "Affordable general-purpose LLM nodes and high-memory boards.",
      "enabled": true,
      "match": {
        "categories": ["compute_node", "mini_pc", "sbc", "dev_board", "embedded_board", "specialty_board"],
        "min_memory_gb": 16
      },
      "alerts": {
        "price_drop_pct": 10,
        "landed_cost_change_pct": 8,
        "stock_return": true,
        "new_product": true,
        "benchmark_change_pct": 12
      }
    },
    {
      "id": "gpu-value",
      "description": "Discrete GPUs with enough fixed VRAM to be useful local-LLM candidates, including current retail and used-market bargains.",
      "enabled": true,
      "match": {
        "categories": ["gpu_accelerator"],
        "min_memory_gb": 12
      },
      "alerts": {
        "price_drop_pct": 8,
        "landed_cost_change_pct": 6,
        "stock_return": true,
        "new_product": true,
        "benchmark_change_pct": 10
      }
    },
    {
      "id": "weird-accelerators",
      "description": "Unusual, specialist and decommissioned accelerators worth watching for bargains.",
      "enabled": true,
      "match": {
        "categories": ["specialty_board", "npu_accelerator", "tpu_accelerator", "ai_asic_accelerator", "fpga_accelerator", "adaptive_soc", "decommissioned_accelerator"]
      },
      "alerts": {
        "price_drop_pct": 12,
        "landed_cost_change_pct": 10,
        "stock_return": true,
        "new_product": true,
        "benchmark_change_pct": 15
      }
    },
    {
      "id": "secondary-accelerator-value",
      "description": "Focused used/decommissioned accelerator watch. Price alerts are investigation signals only; canonical promotion also requires exact identity and verified transformer runtime evidence.",
      "enabled": true,
      "match": {
        "categories": ["gpu_accelerator", "ai_asic_accelerator", "fpga_accelerator", "decommissioned_accelerator"],
        "keywords": ["alveo u200", "alveo u250", "alveo u55c", "tenstorrent n150", "tenstorrent n300", "wormhole n150", "wormhole n300", "habana gaudi", "gaudi2", "gaudi 2", "instinct mi60", "nvidia a40"]
      },
      "alerts": {
        "price_drop_pct": 7,
        "landed_cost_change_pct": 5,
        "stock_return": true,
        "new_product": true,
        "benchmark_change_pct": 10
      }
    },
    {
      "id": "low-power-24-7",
      "description": "Low-power candidates suitable for always-on or constrained-power use.",
      "enabled": true,
      "match": {
        "max_power_w": 25
      },
      "alerts": {
        "price_drop_pct": 10,
        "landed_cost_change_pct": 8,
        "stock_return": true,
        "new_product": true,
        "benchmark_change_pct": 10
      }
    }
  ]
}
